# Environment Variables for Portfolio
# Rename this file to .env and add your actual API keys

# GitHub Personal Access Token (for higher API rate limits)
# Create one at: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
REACT_APP_GITHUB_TOKEN=your_github_token_here

# OpenAI API Key (for AI-generated descriptions and images)
# Get one at: https://platform.openai.com/account/api-keys
REACT_APP_OPENAI_KEY=your_openai_api_key_here

# Optional: Analytics ID
REACT_APP_GA_ID=your_google_analytics_id_here